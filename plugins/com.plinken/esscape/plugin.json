  "format": "tar.gz",
  "has_ui": true,
  "ui": {
    "compact_size": {
      "width": 380,
      "height": 56
    },
    "expanded_size": {
      "width": 660,
      "height": 400
    }
  },
  "plugins": [
    {
      "id": "com.plinken.esscape",
      "name": "Esscape",
      "features": [
        "audio-effect",
        "de-esser",
        "dynamics"
      ],
      "has_ui": true
    }
  ]
}
